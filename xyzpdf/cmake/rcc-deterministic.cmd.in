@echo off
rem Generated by CMake from cmake/rcc-deterministic.cmd.in -- do not edit, do
rem not commit. Everything rcc is asked to do is kept; the one thing changed is
rem the date it writes, so that two builds of one source produce one binary.
set "QT_RCC_SOURCE_DATE_OVERRIDE=@XYZPDF_RCC_SOURCE_DATE@"
"@XYZPDF_RCC_REAL@" %*
exit /b %ERRORLEVEL%
