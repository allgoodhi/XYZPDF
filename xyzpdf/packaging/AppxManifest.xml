<?xml version="1.0" encoding="utf-8"?>
<!--
  The local test package.

  Version is the placeholder 0.0.0.0 on purpose. packaging/build-package.ps1
  stamps the real one in from the generated version header, which is the same
  number the About box shows and the VERSIONINFO resource carries. A number
  written here would be a number nobody bumps, and the Store is the place that
  notices. tests/version_smoke.cpp checks both halves of that arrangement: that
  this file still parses, and that the version in it is still the placeholder.

  Identity/@Name has no space in it, because the schema does not allow one;
  Properties/DisplayName is where the name people read goes.

  What is here now: the .pdf association, the preview pane handler, the thumbnail
  provider and the context menu verb. Each names a CLSID that has to agree with
  the one compiled into the DLL it points at, which is the sort of pair that
  drifts, so the smoke tests read the same numbers from the same source.

  Why the handlers have to be here rather than left to the registry: the program
  removes its own HKCU entries when it detects an installed package
  (src/windows/shellintegration.cpp), and docs/store-submission.md section 3
  records what that costs when the package declares nothing.

  (No double hyphens anywhere in these comments: an XML comment may not contain
  two in a row, and a reader refuses the whole file when it does. That is
  exactly what this file did on its first build, which the version test caught.)
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap com desktop2 desktop4 desktop5">

  <Identity
    Name="allgoodhi.XYZPDF"
    Publisher="CN=allgoodhi"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>XYZPDF</DisplayName>
    <PublisherDisplayName>allgoodhi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <!--
      Every language the program can be is listed here as well as in
      src/core/languages.cpp, because the package's language list is what
      Windows shows in the Store and in Settings. tools/add_language.py writes
      both when a language is added, which is the only way the two stay in step.
    -->
    <Resource Language="en" />
  </Resources>

  <Applications>
    <!-- bin\ because that is where the install step puts the executable, which
         is where packaging/build-package.ps1 stages the package from. A path
         here that disagrees with the layout is a pack failure about a missing
         file, which the script checks for before calling makeappx. -->
    <Application Id="XYZPDF" Executable="bin\xyzpdf.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="XYZPDF"
        Description="Windows PDF 阅读器"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <!-- The association is what makes this program show up in 设置 > 应用 >
           默认应用 and in the 打开方式 list. It has to be declared here rather
           than left to the registry entries the program writes itself, because
           mainwindow.cpp removes those the moment it sees our own package
           installed. See docs/store-submission.md section 3.2, which is about
           exactly this pair disagreeing.

           The 用 XYZPDF 打开 item in the right click menu comes from the
           IExplorerCommand handler declared at the bottom of this file: a
           packaged app cannot write the shell key that the loose build uses, so
           the verb has to be carried inside the package or the menu loses it. -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF 文档</uap:DisplayName>
            <uap:InfoTip>用 XYZPDF 阅读 PDF</uap:InfoTip>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <!-- The same CLSID compiled into src/windows/previewhandler.cpp. This
                 is what points the preview pane at the handler for this file
                 type; the server itself is declared below. -->
            <desktop2:DesktopPreviewHandler Clsid="12DF01C2-01D6-4AF8-AD5F-969C3C3F88D7" />
            <!-- And the icon views: the same file type, a different handler, whose
                 CLSID is compiled into src/windows/thumbnailprovider.cpp. The
                 manifest schema requires a thumbnail CLSID to be declared under a
                 com:SurrogateServer (a stricter rule than the preview pane's), so
                 this one runs out of process too rather than inside explorer.exe. -->
            <desktop2:ThumbnailHandler Clsid="4032B809-B50E-4F0A-AFC1-D300803A81CE" />
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!--
          The COM server behind the preview pane. Explorer (or dllhost, which is
          what actually hosts it) loads bin\xyzpdfpreview.dll out of the package
          and asks this CLSID for an IPreviewHandler.

          That this works at all with the package registered loosely from a
          directory was measured, not assumed: docs/store-submission.md section 5
          records the probe that measured it, and the two facts that came with it:
          the host is DllHost, and the DLL's own libraries have to be delay-loaded
          because the loader looks beside System32.
        -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="XYZPDF 预览">
              <com:Class Id="12DF01C2-01D6-4AF8-AD5F-969C3C3F88D7"
                         Path="bin\xyzpdfpreview.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
            <!-- The thumbnail provider, in the same shape and for the same
                 reasons: it reads the file, so it carries Qt, so it is delay
                 loaded and hosted by DllHost. A separate surrogate from the pane's,
                 which is what COM makes of two CLSIDs anyway. -->
            <com:SurrogateServer DisplayName="XYZPDF 缩略图">
              <com:Class Id="4032B809-B50E-4F0A-AFC1-D300803A81CE"
                         Path="bin\xyzpdfthumbnail.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
            <!-- The context menu verb. It carries no Qt and reads no document, so
                 it is its own server rather than another class in one of the two
                 above, but the shell reaches packaged COM objects only through a
                 declaration like this one, so it is a surrogate too. -->
            <com:SurrogateServer DisplayName="XYZPDF 右键菜单">
              <com:Class Id="8AFE6540-7E46-4349-BE06-ECD418310E42"
                         Path="bin\xyzpdfshell.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <!-- Where that verb is offered: on a .pdf, and on nothing else. The
             handler also refuses a selection that is not all PDFs, because the
             shell asks about mixed selections regardless of what was declared
             here, and GetState is the place that actually decides. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".pdf">
              <desktop5:Verb Id="xyzpdfopen" Clsid="8AFE6540-7E46-4349-BE06-ECD418310E42" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The only capability this program needs: run as an ordinary desktop
         application, with the user's own file access. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
