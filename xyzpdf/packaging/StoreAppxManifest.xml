<?xml version="1.0" encoding="utf-8"?>
<!--
  The Store package.

  In its substance this is AppxManifest.xml, and the duplication is a cost:
  anything added to the layout (an association, a handler, a language) has to be
  added to both files, and nothing checks that it was. Only the language list is
  scripted; tools/add_language.py writes both. The CLSIDs are the ones to watch,
  because each has to equal a number compiled into a DLL. The handler smoke tests
  check that the compiled numbers are the ones this project settled on, so a
  mismatch introduced only here would surface as a preview pane that says nothing
  at all rather than as a failing test.

  It is paid anyway because the two are packed for different audiences: this one
  is what a Store submission is built from, and a submission is the one thing here
  that cannot be taken back quietly.

  The identity below is the development one, and it is a starting point rather
  than a claim. packaging/build-store-package.ps1 overwrites Name, Publisher and
  both display names with the values stamped into the build's generated
  packageconfig.h, so what a package carries is what the build was configured
  with, never what happens to be committed here. The placeholder is therefore the
  local publisher and not a plausible-looking reserved one: nothing has been
  reserved in Partner Center for this program yet, and a GUID in that field would
  read as if it had. Stamping rather than checking is safe because that script
  refuses to pack at all while the header still says CN=allgoodhi, which is the
  only way this file's values could have reached a submission by accident.

  src/core/packageconfig.h.in is where the program is told the same thing.
  Version is the placeholder that gets stamped, as in AppxManifest.xml.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap com desktop2 desktop4 desktop5">

  <Identity
    Name="allgoodhi.XYZPDF"
    Publisher="CN=allgoodhi"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>XYZPDF</DisplayName>
    <PublisherDisplayName>allgoodhi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en" />
  </Resources>

  <Applications>
    <!-- bin\ is where the install step puts the executable; see the note in
         AppxManifest.xml, which the two have to agree with. -->
    <Application Id="XYZPDF" Executable="bin\xyzpdf.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="XYZPDF"
        Description="Windows PDF 阅读器"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <!-- The same association as the local package, because the two have to
           agree; see the note there for why it cannot be left to the registry
           entries the program writes itself. -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF 文档</uap:DisplayName>
            <uap:InfoTip>用 XYZPDF 阅读 PDF</uap:InfoTip>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <desktop2:DesktopPreviewHandler Clsid="12DF01C2-01D6-4AF8-AD5F-969C3C3F88D7" />
            <desktop2:ThumbnailHandler Clsid="4032B809-B50E-4F0A-AFC1-D300803A81CE" />
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- The preview handler, declared the same way as in AppxManifest.xml;
             the two have to agree. docs/store-submission.md section 5 records how
             it was established that the shell routes this at all. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="XYZPDF 预览">
              <com:Class Id="12DF01C2-01D6-4AF8-AD5F-969C3C3F88D7"
                         Path="bin\xyzpdfpreview.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
            <com:SurrogateServer DisplayName="XYZPDF 缩略图">
              <com:Class Id="4032B809-B50E-4F0A-AFC1-D300803A81CE"
                         Path="bin\xyzpdfthumbnail.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
            <com:SurrogateServer DisplayName="XYZPDF 右键菜单">
              <com:Class Id="8AFE6540-7E46-4349-BE06-ECD418310E42"
                         Path="bin\xyzpdfshell.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <!-- The right click verb, declared the same way as in AppxManifest.xml;
             the two have to agree, including the CLSID compiled into
             src/windows/shellcommand.cpp. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".pdf">
              <desktop5:Verb Id="xyzpdfopen" Clsid="8AFE6540-7E46-4349-BE06-ECD418310E42" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
