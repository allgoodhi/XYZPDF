<?xml version="1.0" encoding="utf-8"?>
<!--
  The Store package.

  Same shape as AppxManifest.xml and deliberately a separate file rather than
  the same one with substitutions: a Store submission is the one thing here that
  cannot be redone quietly, and the values that decide whether it is accepted
  (Identity/@Name and @Publisher, which Partner Center assigns and reserves)
  should be visible in the file they are in rather than assembled from
  variables at pack time.

  Nothing has been reserved in Partner Center for this program yet, so the
  identity below is still the development one. packaging/build-store-package.ps1
  overrides the three identity values on the command line once they exist; see
  src/core/packageconfig.h.in for how the program is told the same thing.

  Version is the placeholder that gets stamped, as in AppxManifest.xml.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap com desktop2 desktop4 desktop5">

  <Identity
    Name="allgoodhi.XYZPDF"
    Publisher="CN=3C3318D2-C146-4BCB-AE5B-29787FFF4D89"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>XYZPDF</DisplayName>
    <PublisherDisplayName>allgoodhi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en" />
  </Resources>

  <Applications>
    <!-- bin\ is where the install step puts the executable; see the note in
         AppxManifest.xml, which the two have to agree with. -->
    <Application Id="XYZPDF" Executable="bin\xyzpdf.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="XYZPDF"
        Description="Windows PDF 阅读器"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <!-- The same association as the local package, because the two have to
           agree; see the note there for why it cannot be left to the registry
           entries the program writes itself. -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF 文档</uap:DisplayName>
            <uap:InfoTip>用 XYZPDF 阅读 PDF</uap:InfoTip>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <desktop2:DesktopPreviewHandler Clsid="12DF01C2-01D6-4AF8-AD5F-969C3C3F88D7" />
            <desktop2:ThumbnailHandler Clsid="4032B809-B50E-4F0A-AFC1-D300803A81CE" />
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- The preview handler, declared the same way as in AppxManifest.xml;
             the two have to agree. docs/store-submission.md section 5 records how
             it was established that the shell routes this at all. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="XYZPDF 预览">
              <com:Class Id="12DF01C2-01D6-4AF8-AD5F-969C3C3F88D7"
                         Path="bin\xyzpdfpreview.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
            <com:SurrogateServer DisplayName="XYZPDF 缩略图">
              <com:Class Id="4032B809-B50E-4F0A-AFC1-D300803A81CE"
                         Path="bin\xyzpdfthumbnail.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
            <com:SurrogateServer DisplayName="XYZPDF 右键菜单">
              <com:Class Id="8AFE6540-7E46-4349-BE06-ECD418310E42"
                         Path="bin\xyzpdfshell.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <!-- The right click verb, declared the same way as in AppxManifest.xml;
             the two have to agree, including the CLSID compiled into
             src/windows/shellcommand.cpp. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".pdf">
              <desktop5:Verb Id="xyzpdfopen" Clsid="8AFE6540-7E46-4349-BE06-ECD418310E42" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
